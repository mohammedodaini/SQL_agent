# Copy this file to .env and put your own values in it.
# Never commit .env, because it has your real password and API key in it.

# Database settings.
# Use a MySQL user that is only allowed to SELECT. The agent writes its own
# SQL, so the database should be the thing that stops a bad query, not the
# prompt:
#   CREATE USER 'sqlagent'@'localhost' IDENTIFIED BY 'your_password_here';
#   GRANT SELECT ON Chinook.* TO 'sqlagent'@'localhost';
DB_USER=sqlagent
DB_PASS=your_password_here
DB_HOST=localhost
DB_NAME=Chinook

# Groq API key, from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
